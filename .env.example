VIRUSTOTAL_MAX_RETRIES=2
VIRUSTOTAL_RETRY_BACKOFF_SECONDS=0.2
VIRUSTOTAL_CACHE_TTL_SECONDS=900
OTX_API_KEY=
OPSWAT_API_KEY=
# URLhaus is the configured no-key alternative to PhishTank.
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/url/
URLHAUS_AUTH_KEY=
# Leave empty unless a genuine PhishTank endpoint/key is configured.
PHISHTANK_API_URL=
IPINFO_TOKEN=
IP_INTELLIGENCE_PROVIDER=freeipapi
FREEIPAPI_BASE_URL=https://freeipapi.com/api/json/
IPINFO_BASE_URL=https://api.ipinfo.io/lite
IPINFO_TIMEOUT_SECONDS=6
IPINFO_CACHE_TTL_SECONDS=3600
IPINFO_MAX_IPS_PER_SCAN=10
MAX_PAGE_SIZE_BYTES=1000000
MAX_REDIRECT_HOPS=5
PROVIDER_TIMEOUT_SECONDS=8
RDAP_BOOTSTRAP_URL=https://data.iana.org/rdap/dns.json
RDAP_TIMEOUT_SECONDS=8
RDAP_MAX_REDIRECTS=3
CERTIFICATE_REVOCATION_TIMEOUT_SECONDS=6
CERTIFICATE_REVOCATION_CACHE_TTL_SECONDS=900
# Comma-separated SHA-256 certificate fingerprints from an authoritative distrust decision.
CERTIFICATE_DISTRUST_FINGERPRINTS=
CA_REPUTATION_FEED_URL=
CA_REPUTATION_FEED_TTL_SECONDS=21600
TLS_GRADING_TIMEOUT_SECONDS=5
TLS_MINIMUM_VERSION=TLSv1.2
TLS_MINIMUM_CIPHER_BITS=128
CERTIFICATE_RISK_WEIGHTS_JSON={}

# Production infrastructure (development defaults preserve the existing SQLite app).
ENVIRONMENT=development
AUTH_REQUIRED=false
OIDC_ISSUER_URL=http://localhost:8080/realms/threat-intelligence
OIDC_JWKS_URL=http://localhost:8080/realms/threat-intelligence/protocol/openid-connect/certs
OIDC_AUDIENCE=threat-intelligence-api
OIDC_CLIENT_ID=threat-intelligence-app
OIDC_AUTHORIZATION_URL=http://localhost:8080/realms/threat-intelligence/protocol/openid-connect/auth
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid profile email
SESSION_COOKIE_NAME=digital_trust_session
SESSION_MAX_AGE_SECONDS=3600
OIDC_ADMIN_ROLES=admin
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_CONNECT_TIMEOUT_SECONDS=10
REDIS_URL=
REDIS_NAMESPACE=digital-trust
REDIS_TIMEOUT_SECONDS=2
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIMEOUT_SECONDS=120
ML_RETRAINING_SCHEDULE=
ML_RETRAINING_DATASET_ID=0
