ML_MIN_F1=0.0
ML_MAX_FALSE_NEGATIVE_RATE=1.0
ML_MAX_F1_REGRESSION=0.01
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
LLM_API_KEY=
